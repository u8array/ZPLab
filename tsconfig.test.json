{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**/*.ts",
    "tests/**/*.ts",
    "packages/core/src/**/*.test.ts"
  ],
  "exclude": [
    "src/test/labelarySync.test.ts",
    "src/test/visualRegression.test.ts",
    "src/**/*.local.test.*",
    "packages/core/src/**/*.local.test.*",
    "tests/**/*.local.ts"
  ]
}
