{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    // Own build info, since the inherited path is the app project's.
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.server.tsbuildinfo",
    // DOM lib inherited from tsconfig.app.json: @zplab/core's type graph
    // references DOM types, so a Node-only lib fails to type-check.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.local.*"]
}
