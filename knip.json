{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "src-tauri/**"
  ],
  "ignoreBinaries": [
    "reg"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.d.mts",
        "scripts/sea/*.mjs",
        "scripts/sea/*.d.mts",
        "scripts/catalog-reference-merge.mjs",
        "scripts/gen-gs1-catalog.mjs",
        "tests/scripts/*.ts"
      ],
      "ignoreDependencies": [
        "postject"
      ]
    },
    "packages/core": {
      "includeEntryExports": true
    },
    "packages/headless": {
      "includeEntryExports": true
    }
  }
}
